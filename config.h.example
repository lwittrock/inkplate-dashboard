#ifndef CONFIG_H
#define CONFIG_H

// ============================================================================
// Copy this file to config.h. Secrets live in secrets.h (also gitignored).
// Both files are gitignored — never commit them. In production the CI
// secrets CONFIG_H and SECRETS_H are the device's config (see CLAUDE.md).
// ============================================================================

#include "secrets.h"

// The thin client needs nothing here: every setting has a default in code.
// Location, stations, the wake cadence, night mode and the refresh rhythm
// all moved to the screen service on the home server. An older config.h
// that still defines them compiles fine; the firmware ignores them.

// ============================================================================
// OPTIONAL: STATIC IP (strongly recommended: skips DHCP on every wake)
// ============================================================================
// If the static address stops working (a router swap), the firmware falls
// back to DHCP by itself. Production uses 192.168.1.220, bound on the router.
// #define WIFI_STATIC_IP "192.168.1.220"
// #define WIFI_GATEWAY   "192.168.1.1"
// #define WIFI_SUBNET    "255.255.255.0"
// #define WIFI_DNS       "192.168.1.1"

// ============================================================================
// OPTIONAL: THE SCREEN SERVICE
// ============================================================================
// Default: http://192.168.1.212:8088/v1/screen (CT 106). Override only if
// the service moves, e.g. to a laptop for a bench test.
// #define SCREEN_URL "http://192.168.1.212:8088/v1/screen"

// ============================================================================
// OPTIONAL: DEBUG LOGGING
// ============================================================================
// Serial output at 115200 baud. Costs ~200 ms per wake; off in production.
// #define DEBUG_LOG 1

// ============================================================================
// OPTIONAL: OTA
// ============================================================================
// The manifest URL has a default in D_OTA.ino; override only for a fork.
// #define OTA_MANIFEST_URL "https://raw.githubusercontent.com/<you>/<repo>/firmware-latest/version.txt"
//
// Development only: check the manifest on every wake instead of when a
// trigger says so. Each check is an HTTPS request; never in production.
// #define OTA_TEST_FORCE_CHECK 1
//
// Bench flashes only: never check for updates. A local build is "dev",
// which counts as older than any release, so without this it replaces
// itself with the newest release on its first wake (CLAUDE.md, "OTA
// gotchas"). NEVER in the CONFIG_H secret: a device that never updates
// can only be fixed with a USB cable. CI refuses to build if it is there.
// #define OTA_SKIP 1
//
// Bench flashes only: cap every sleep, so the failure path and the second
// wake can be tested in minutes. NEVER in CONFIG_H either: CI refuses it.
// #define BENCH_MAX_SLEEP_S 60

#endif
