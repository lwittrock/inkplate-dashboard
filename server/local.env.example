# Copy to local.env (gitignored) on the laptop. On the server the same lines
# live in /etc/inkplate-screen.env, root-only.

# Where the weather is for. Defaults to Delft when unset.
LATITUDE=52.0705
LONGITUDE=4.3007

# NS API portal subscription key (Reisinformatie). Needed for trains.
NS_API_KEY=

# 1 = firmware version next to the battery in the footer.
SHOW_VERSION_FOOTER=0

# grey (default) or mono: which frame to send a device that can draw both.
# mono is the 1-bit panel mode, needed only for a real partial refresh.
SCREEN_FORMAT=grey

# smooth (default) or crisp: in greyscale, draw text under 14 px without
# anti-aliasing. Which reads better on the panel is a bench question.
SMALL_TEXT=smooth

# --- service only (python -m screen.service) ---
# Where to listen. On the laptop use 127.0.0.1 to avoid a firewall prompt.
BIND=0.0.0.0
PORT=8088
# Home Assistant webhook for the device's reports; the id is a secret.
HA_WEBHOOK_URL=
# healthchecks.io ping URLs: the device's requests, and each render.
HC_PING_INKPLATE=
HC_PING_RENDER=
# systemd sets STATE_DIRECTORY; without it, state goes to server/state/.
